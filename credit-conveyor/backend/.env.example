# Локальная разработка без Docker. Скопируйте в backend/.env и поправьте при необходимости.
# Все переменные и значения по умолчанию — в app/config.py.

DATABASE_URL=postgresql+psycopg://localhost:5432/credit_conveyor
JWT_SECRET=dev-only-secret-change-me-in-production-env
MOCKS_URL=http://localhost:8001

# Пауза на каждом шаге конвейера — чтобы в интерфейсе было видно смену статусов
PIPELINE_STEP_DELAY_SEC=1.0

# Сбои моков: 0.3 — примерно каждый третий ответ внешнего источника будет 503
MOCK_FAILURE_RATE=0
