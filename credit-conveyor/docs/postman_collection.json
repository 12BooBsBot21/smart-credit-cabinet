{
  "info": {
    "name": "Кредитный конвейер МСБ",
    "description": "Сквозной сценарий: клиент подаёт заявку, конвейер принимает решение, клиент подписывает. Затем андеррайтер решает заявку на ручной проверке. Между шагами «Отправить» и «Статус» подождите несколько секунд — заявку обрабатывает воркер.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    },
    {
      "key": "offerId",
      "value": ""
    },
    {
      "key": "signCode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Служебное",
      "item": [
        {
          "name": "Каталог продуктов",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        },
        {
          "name": "Тестовые учётки",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/demo-accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "demo-accounts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Клиент: одобрение и подписание",
      "item": [
        {
          "name": "Вход клиента (bakery)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"bakery\",\n  \"password\": \"demo\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);",
                  "pm.collectionVariables.set('token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Компания клиента",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/companies/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "companies",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        },
        {
          "name": "Создать заявку",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_code\": \"working-capital\",\n  \"amount\": 2000000,\n  \"term_months\": 24,\n  \"purpose\": \"Закупка муки и упаковки\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);",
                  "pm.collectionVariables.set('applicationId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Отправить в банк",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{applicationId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "{{applicationId}}",
                "submit"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        },
        {
          "name": "Статус заявки (повторять, пока не APPROVED)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{applicationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "{{applicationId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);",
                  "const app = pm.response.json();",
                  "console.log('status', app.status);",
                  "if (app.offers.length) pm.collectionVariables.set('offerId', app.offers[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Принять предложение",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{applicationId}}/offers/{{offerId}}/accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "{{applicationId}}",
                "offers",
                "{{offerId}}",
                "accept"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);",
                  "pm.collectionVariables.set('signCode', pm.response.json().sign_code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Подписать договор",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{applicationId}}/sign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "{{applicationId}}",
                "sign"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{signCode}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);",
                  "pm.test('ISSUED', () => pm.expect(pm.response.json().status).to.eql('ISSUED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Андеррайтер: ручная проверка",
      "item": [
        {
          "name": "Вход клиента (vector)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"vector\",\n  \"password\": \"demo\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);",
                  "pm.collectionVariables.set('token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Заявка под залог 8 млн ₽",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_code\": \"secured-loan\",\n  \"amount\": 8000000,\n  \"term_months\": 36,\n  \"purpose\": \"Расширение склада\",\n  \"collateral_description\": \"Складское помещение 1 200 м², г. Подольск\",\n  \"collateral_value\": 12000000\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);",
                  "pm.collectionVariables.set('applicationId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Отправить в банк",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/applications/{{applicationId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications",
                "{{applicationId}}",
                "submit"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        },
        {
          "name": "Вход андеррайтера",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"underwriter\",\n  \"password\": \"demo\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);",
                  "pm.collectionVariables.set('token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Очередь ручной проверки",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bank/applications?status=MANUAL_REVIEW",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bank",
                "applications"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "MANUAL_REVIEW"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        },
        {
          "name": "Карточка заявки",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bank/applications/{{applicationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bank",
                "applications",
                "{{applicationId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        },
        {
          "name": "Решение: иные условия",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bank/applications/{{applicationId}}/decision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bank",
                "applications",
                "{{applicationId}}",
                "decision"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"COUNTER_OFFER\",\n  \"amount\": 6000000,\n  \"term_months\": 36,\n  \"comment\": \"Массовый адрес — снижаем сумму\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);"
                ]
